{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 28, "patch": 0},
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "A build tree named after the preset, with the compiler launchers from the environment, so exporting CMAKE_CXX_COMPILER_LAUNCHER=ccache caches objects.",
      "binaryDir": "${sourceDir}/build_${presetName}",
      "cacheVariables": {
        "UCALL_BUILD_TEST": "ON",
        "CMAKE_C_COMPILER_LAUNCHER": "$env{CMAKE_C_COMPILER_LAUNCHER}",
        "CMAKE_CXX_COMPILER_LAUNCHER": "$env{CMAKE_CXX_COMPILER_LAUNCHER}"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}
    },
    {
      "name": "windows",
      "hidden": true,
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": {"CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++"}
    },
    {
      "name": "debug",
      "inherits": ["base", "clang"],
      "displayName": "Host Debug",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
    },
    {
      "name": "check",
      "inherits": ["base", "clang"],
      "displayName": "Host Check with every target and warnings as errors",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O0 -g0 -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O0 -g0 -DNDEBUG",
        "UCALL_BUILD_TOOLS": "ON",
        "UCALL_BUILD_BENCH": "ON",
        "UCALL_WERROR": "ON"
      }
    },
    {
      "name": "relwithdebinfo",
      "inherits": ["base", "clang"],
      "displayName": "Host RelWithDebInfo",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}
    },
    {
      "name": "release",
      "inherits": ["base", "clang"],
      "displayName": "Host Release",
      "description": "The suites and the shared library, with build paths remapped so the binaries name none.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "-ffile-prefix-map=${sourceDir}=.",
        "CMAKE_CXX_FLAGS": "-ffile-prefix-map=${sourceDir}=.",
        "UCALL_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "debug",
      "displayName": "Host Debug with AddressSanitizer and UndefinedBehaviorSanitizer",
      "cacheVariables": {"UCALL_BUILD_SANITIZERS": "address"}
    },
    {
      "name": "tsan",
      "inherits": "debug",
      "displayName": "Host Debug with ThreadSanitizer",
      "cacheVariables": {"UCALL_BUILD_SANITIZERS": "thread"}
    },
    {
      "name": "msvc2026_x64",
      "inherits": ["base", "windows"],
      "displayName": "Windows x64 - Visual Studio 2026",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    },
    {
      "name": "android_arm64",
      "inherits": "base",
      "displayName": "Android ARM64 - compile only",
      "description": "The library over the epoll backend, through the NDK's own toolchain from ANDROID_NDK_ROOT.",
      "toolchainFile": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "UCALL_BUILD_TEST": "OFF",
        "UCALL_WITH_LINUX_EPOLLAIO": "ON"
      }
    },
    {
      "name": "machine",
      "hidden": true,
      "inherits": ["base", "linux", "clang"],
      "description": "One machine: its CPU floor, every kernel-library capability spelled as 1 or 0, and its one GPU code.",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "UCALL_BUILD_TEST": "OFF", "UCALL_MULTIVERSIONED": "OFF"}
    },
    {
      "name": "xeon4_hopper",
      "inherits": "machine",
      "displayName": "Xeon 4 with Hopper - compile only",
      "cacheVariables": {
        "UCALL_MARCH": "sapphirerapids",
        "NUMKONG_TARGET_HASWELL": "1",
        "NUMKONG_TARGET_SKYLAKE": "1",
        "NUMKONG_TARGET_ICELAKE": "1",
        "NUMKONG_TARGET_GENOA": "1",
        "NUMKONG_TARGET_SAPPHIRE": "1",
        "NUMKONG_TARGET_SAPPHIREAMX": "1",
        "NUMKONG_TARGET_GRANITEAMX": "0",
        "NUMKONG_TARGET_DIAMOND": "0",
        "NUMKONG_TARGET_DIAMONDAMX": "0",
        "NUMKONG_TARGET_TURIN": "0",
        "NUMKONG_TARGET_ALDER": "1",
        "NUMKONG_TARGET_SIERRA": "0",
        "STRINGZILLA_TARGET_WESTMERE": "1",
        "STRINGZILLA_TARGET_GOLDMONT": "1",
        "STRINGZILLA_TARGET_HASWELL": "1",
        "STRINGZILLA_TARGET_SKYLAKE": "1",
        "STRINGZILLA_TARGET_ICELAKE": "1",
        "FORKUNION_TARGET_X86_PAUSE": "1",
        "FORKUNION_TARGET_X86_TPAUSE": "1",
        "FORKUNION_TARGET_X86_CLDEMOTE": "1",
        "FORKUNION_TARGET_X86_CMPCCXADD": "0",
        "FORKUNION_TARGET_X86_RAOINT": "0"
      }
    },
    {
      "name": "xeon6_blackwell",
      "inherits": "machine",
      "displayName": "Xeon 6 with Blackwell - compile only",
      "cacheVariables": {
        "UCALL_MARCH": "graniterapids",
        "NUMKONG_TARGET_HASWELL": "1",
        "NUMKONG_TARGET_SKYLAKE": "1",
        "NUMKONG_TARGET_ICELAKE": "1",
        "NUMKONG_TARGET_GENOA": "1",
        "NUMKONG_TARGET_SAPPHIRE": "1",
        "NUMKONG_TARGET_SAPPHIREAMX": "1",
        "NUMKONG_TARGET_GRANITEAMX": "1",
        "NUMKONG_TARGET_DIAMOND": "0",
        "NUMKONG_TARGET_DIAMONDAMX": "0",
        "NUMKONG_TARGET_TURIN": "0",
        "NUMKONG_TARGET_ALDER": "1",
        "NUMKONG_TARGET_SIERRA": "0",
        "STRINGZILLA_TARGET_WESTMERE": "1",
        "STRINGZILLA_TARGET_GOLDMONT": "1",
        "STRINGZILLA_TARGET_HASWELL": "1",
        "STRINGZILLA_TARGET_SKYLAKE": "1",
        "STRINGZILLA_TARGET_ICELAKE": "1",
        "FORKUNION_TARGET_X86_PAUSE": "1",
        "FORKUNION_TARGET_X86_TPAUSE": "1",
        "FORKUNION_TARGET_X86_CLDEMOTE": "1",
        "FORKUNION_TARGET_X86_CMPCCXADD": "0",
        "FORKUNION_TARGET_X86_RAOINT": "0"
      }
    },
    {
      "name": "grace_hopper",
      "inherits": "machine",
      "displayName": "Grace with Hopper - compile only",
      "description": "Grace's 128-bit SVE gains nothing over NEON, so every SVE capability is off.",
      "cacheVariables": {
        "UCALL_MARCH": "grace",
        "NUMKONG_TARGET_NEON": "1",
        "NUMKONG_TARGET_NEONHALF": "1",
        "NUMKONG_TARGET_NEONSDOT": "1",
        "NUMKONG_TARGET_NEONBFDOT": "1",
        "NUMKONG_TARGET_NEONFHM": "1",
        "NUMKONG_TARGET_SVE": "0",
        "NUMKONG_TARGET_SVEHALF": "0",
        "NUMKONG_TARGET_SVEBFDOT": "0",
        "NUMKONG_TARGET_SVESDOT": "0",
        "NUMKONG_TARGET_SVE2": "0",
        "NUMKONG_TARGET_NEONFP8": "0",
        "NUMKONG_TARGET_SME": "0",
        "NUMKONG_TARGET_SMEF64": "0",
        "NUMKONG_TARGET_SMEBI32": "0",
        "STRINGZILLA_TARGET_NEON": "1",
        "STRINGZILLA_TARGET_NEONAES": "1",
        "STRINGZILLA_TARGET_NEONSHA": "1",
        "STRINGZILLA_TARGET_SVE": "0",
        "STRINGZILLA_TARGET_SVE2": "0",
        "STRINGZILLA_TARGET_SVE2AES": "0",
        "FORKUNION_TARGET_ARM64_YIELD": "1",
        "FORKUNION_TARGET_ARM64_WFET": "0",
        "FORKUNION_TARGET_ARM64_DC_CVAC": "1",
        "FORKUNION_TARGET_ARM64_PRFM": "1",
        "FORKUNION_TARGET_ARM64_LSE": "1",
        "FORKUNION_TARGET_ARM64_RCPC": "1"
      }
    },
    {
      "name": "vera_rubin",
      "inherits": "machine",
      "displayName": "Vera with Rubin - compile only",
      "description": "Olympus cores need Clang 22 or GCC 15 and CUDA 13.4 names no Rubin code, so it compiles 100f; WFET is on, as no compiler macro reports it, and SVE off, as on Grace.",
      "cacheVariables": {
        "UCALL_MARCH": "olympus",
        "NUMKONG_TARGET_NEON": "1",
        "NUMKONG_TARGET_NEONHALF": "1",
        "NUMKONG_TARGET_NEONSDOT": "1",
        "NUMKONG_TARGET_NEONBFDOT": "1",
        "NUMKONG_TARGET_NEONFHM": "1",
        "NUMKONG_TARGET_SVE": "0",
        "NUMKONG_TARGET_SVEHALF": "0",
        "NUMKONG_TARGET_SVEBFDOT": "0",
        "NUMKONG_TARGET_SVESDOT": "0",
        "NUMKONG_TARGET_SVE2": "0",
        "NUMKONG_TARGET_NEONFP8": "1",
        "NUMKONG_TARGET_SME": "0",
        "NUMKONG_TARGET_SMEF64": "0",
        "NUMKONG_TARGET_SMEBI32": "0",
        "STRINGZILLA_TARGET_NEON": "1",
        "STRINGZILLA_TARGET_NEONAES": "1",
        "STRINGZILLA_TARGET_NEONSHA": "1",
        "STRINGZILLA_TARGET_SVE": "0",
        "STRINGZILLA_TARGET_SVE2": "0",
        "STRINGZILLA_TARGET_SVE2AES": "0",
        "FORKUNION_TARGET_ARM64_YIELD": "1",
        "FORKUNION_TARGET_ARM64_WFET": "1",
        "FORKUNION_TARGET_ARM64_DC_CVAC": "1",
        "FORKUNION_TARGET_ARM64_PRFM": "1",
        "FORKUNION_TARGET_ARM64_LSE": "1",
        "FORKUNION_TARGET_ARM64_RCPC": "1"
      }
    },
    {
      "name": "venice_mi450",
      "inherits": "machine",
      "displayName": "EPYC Venice with MI450 - compile only",
      "description": "Clang 22 names no Zen 6 core, so it compiles at znver5 and spells the rows GCC 16's znver6 implies; gfx1250 covers MI450X and MI455X.",
      "cacheVariables": {
        "UCALL_MARCH": "znver5",
        "NUMKONG_TARGET_HASWELL": "1",
        "NUMKONG_TARGET_SKYLAKE": "1",
        "NUMKONG_TARGET_ICELAKE": "1",
        "NUMKONG_TARGET_GENOA": "1",
        "NUMKONG_TARGET_SAPPHIRE": "1",
        "NUMKONG_TARGET_SAPPHIREAMX": "0",
        "NUMKONG_TARGET_GRANITEAMX": "0",
        "NUMKONG_TARGET_DIAMOND": "0",
        "NUMKONG_TARGET_DIAMONDAMX": "0",
        "NUMKONG_TARGET_TURIN": "1",
        "NUMKONG_TARGET_ALDER": "1",
        "NUMKONG_TARGET_SIERRA": "1",
        "STRINGZILLA_TARGET_WESTMERE": "1",
        "STRINGZILLA_TARGET_GOLDMONT": "1",
        "STRINGZILLA_TARGET_HASWELL": "1",
        "STRINGZILLA_TARGET_SKYLAKE": "1",
        "STRINGZILLA_TARGET_ICELAKE": "1",
        "FORKUNION_TARGET_X86_PAUSE": "1",
        "FORKUNION_TARGET_X86_TPAUSE": "0",
        "FORKUNION_TARGET_X86_CLDEMOTE": "1",
        "FORKUNION_TARGET_X86_CMPCCXADD": "0",
        "FORKUNION_TARGET_X86_RAOINT": "0"
      }
    }
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug"},
    {"name": "check", "configurePreset": "check"},
    {"name": "relwithdebinfo", "configurePreset": "relwithdebinfo"},
    {"name": "release", "configurePreset": "release"},
    {"name": "asan", "configurePreset": "asan"},
    {"name": "tsan", "configurePreset": "tsan"},
    {"name": "msvc2026_x64", "configurePreset": "msvc2026_x64", "configuration": "Release"},
    {"name": "android_arm64", "configurePreset": "android_arm64"},
    {"name": "xeon4_hopper", "configurePreset": "xeon4_hopper"},
    {"name": "xeon6_blackwell", "configurePreset": "xeon6_blackwell"},
    {"name": "grace_hopper", "configurePreset": "grace_hopper"},
    {"name": "vera_rubin", "configurePreset": "vera_rubin"}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}},
    {"name": "relwithdebinfo", "configurePreset": "relwithdebinfo", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {"outputOnFailure": true},
      "environment": {"UBSAN_OPTIONS": "halt_on_error=1 print_stacktrace=1"}
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {"outputOnFailure": true},
      "environment": {"TSAN_OPTIONS": "halt_on_error=1"}
    },
    {
      "name": "msvc2026_x64",
      "configurePreset": "msvc2026_x64",
      "configuration": "Release",
      "output": {"outputOnFailure": true}
    }
  ]
}
