    [ ! -f "$results_directory/$ordinal.added" ] || added=$(< "$results_directory/$ordinal.added")
    [ -s "$staged_lines_path" ] || echo > "$staged_lines_path"
    added_lines=$(< "$staged_lines_path")
    case "$file" in
    *.c | *.h | *.hpp | *.cpp | *.cc | *.cxx)
        check_ascii_arrows
        check_glued_arrows
        check_ids_capitalized
        check_backward_references
        check_prose_comment_width
        check_prose_paragraph_filled
        check_region_labels
        check_region_lengths
        check_namespace_directories
