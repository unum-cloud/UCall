#!/usr/bin/env bash
# Checks staged additions and their surrounding scopes, leaving untouched code to migrate separately.
set -u
export LC_ALL=C
rejection_count=0
project_include_prefix="ucall"
sibling_projects='numkong|stringzilla|forkunion|smashtable|usearch|ustore|uform'
cmake_published_variables="UCALL_IS_MAIN_PROJECT"
cmake_third_party_variables=""
ids_miscased_pattern='(^|[^[:alnum:]_.:])(id|ids|Id|Ids)([^[:alnum:]_(]|$)'

fail() { # fail <matches> <message-line>...
    local matches=$1
    shift
    local line
    for line in "$@"; do echo "pre-commit: $line"; done
    printf '%s\n' "$matches" | head -5
    rejection_count=$((rejection_count + 1))
}

blank_c_comments_preserving_columns() { # blank_c_comments_preserving_columns < source
    awk '
        {
            output = ""
            for (position = 1; position <= length($0); ++position) {
                character = substr($0, position, 1)
                pair = substr($0, position, 2)
                if (state == "block") {
                    if (pair == "*/") { state = ""; output = output "  "; ++position }
                    else output = output " "
                    continue
                }
                if (state == "string" || state == "character") {
                    output = output character
                    if (character == "\\") { output = output substr($0, position + 1, 1); ++position }
                    else if ((state == "string" && character == "\"") || (state == "character" && character == "\047")) state = ""
                    continue
                }
                if (pair == "//") { tail = substr($0, position); gsub(/./, " ", tail); output = output tail; break }
                if (pair == "/*") { state = "block"; output = output "  "; ++position; continue }
                if (character == "\"") state = "string"
                else if (character == "\047") state = "character"
                output = output character
            }
            if (state != "block") state = ""
            print output
        }'
}

check_ascii_arrows() {
    local arrows
    arrows=$(printf '%s\n' "$added" | grep -E '((//|/\*|^\+[[:space:]]*\*).* -> )' || true)
    [ -z "$arrows" ] || fail "$arrows" \
        "$file uses the ASCII '->' arrow in a comment - prose arrows are the Unicode →:"
}

check_ascii_arrows_prose() {
    local arrows
    arrows=$(printf '%s\n' "$added" | grep -E ' -> ' || true)
    [ -z "$arrows" ] || fail "$arrows" \
        "$file uses the ASCII '->' arrow - prose arrows are the Unicode →:"
}

check_ids_capitalized() {
    local miscased
    miscased=$(printf '%s\n' "$added" | awk '
        { line = substr($0, 2); gsub(/https?:\/\/[^[:space:]]*/, "", line) }
        line ~ /@end(code|verbatim)/ { code = 0; next }
        line ~ /@(code|verbatim)/ { code = 1; next }
        code { next }
        line ~ /^[[:space:]]*(\/\/|\/\*|\*)/ { print line; next }
        { position = index(line, "//"); if (position) print substr(line, position) }' |
        sed -E 's/`[^`]*`//g; s/"[^"]*"//g; s/->/ _arrow_/g; s/@(p|c|a|ref|param|tparam)[[:space:]]+[A-Za-z_][A-Za-z0-9_]*//g' |
        grep -E "$ids_miscased_pattern" || true)
    [ -z "$miscased" ] || fail "$miscased" "$file writes id or ids in a comment - the abbreviation is ID, plural IDs:"
}

check_ids_capitalized_prose() {
    local miscased
    miscased=$(printf '%s\n' "$added" | awk '/^\+[[:space:]]*```/ { fenced = !fenced; next } !fenced && !/^\+(    |\t)/' |
        sed -E 's#https?://[^[:space:]]*##g; s/`[^`]*`//g; s/"[^"]*"//g; s/->/ _arrow_/g; s/^\+//' |
        grep -E "$ids_miscased_pattern" || true)
    [ -z "$miscased" ] || fail "$miscased" "$file writes id or ids - the abbreviation is ID, plural IDs:"
}

check_glued_arrows() {
    local glued
    glued=$(printf '%s\n' "$added" | grep -E '[^[:space:]]→|→[^[:space:]]' || true)
    [ -z "$glued" ] || fail "$glued" \
        "$file glues a Unicode arrow to its neighbor - write \`key → identifier\`, never \`key→identifier\`:"
}

check_blank_line_runs() {
    local runs
    runs=$(awk '
        /^```/ || /^~~~/ { fence = !fence }
        !fence && /^[[:space:]]*$/ { blanks++; if (blanks > 1) print NR ": consecutive blank lines"; next }
        { blanks = 0 }
    ' "$file" || true)
    [ -z "$runs" ] || fail "$runs" \
        "$file separates paragraphs with more than one blank line - Markdown needs exactly one:"
}

check_prose_comment_width() {
    local wide
    wide=$(awk '
        FILENAME == ARGV[1] { added[$1 + 0]; next }
        {
            text = $0
            if (!inside && text ~ /^[[:space:]]*\/\*([^*]|\*[^\/])*\*\/[[:space:]]*[^[:space:]\\]/) next
            if (text ~ /^[[:space:]]*\/\*/) { inside = 1; in_code = 0 }
            prose = inside || text ~ /^[[:space:]]*\/\//
            if (inside && text ~ /@(code|verbatim)/) in_code = 1
            if (inside && text ~ /@end(code|verbatim)/) in_code = 0
            if (inside && text ~ /\*\//) inside = 0
            if (!prose || in_code || !(FNR in added) || text ~ /https?:\/\//) next
            characters = text
            sub(/[[:space:]]*\\$/, "", characters)
            gsub(/[\200-\277]/, "", characters)
            if (length(characters) > 100) printf "line %d: %d columns\n", FNR, length(characters)
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$wide" ] || fail "$wide" \
        "$file writes prose past 100 columns - rewrap it, only code may reach 120:"
}

check_prose_paragraph_filled() {
    local underfilled
    underfilled=$(awk '
        function characters(text) { gsub(/[\200-\277]/, "", text); return length(text) }
        function first_word(text) {
            if (text ~ /^`[^`]*`/) { match(text, /^`[^`]*`[^[:space:]]*/); return substr(text, 1, RLENGTH) }
            # An inline tag moves with its argument, so the pair is what has to fit.
            if (match(text, /^@(c|p|ref|b|a|e|em)[[:space:]]+[^[:space:]]+/)) return substr(text, 1, RLENGTH)
            sub(/[[:space:]].*$/, "", text); return text
        }
        function hold_paragraph_line(line, body, width) { ++held; held_line[held] = line; held_body[held] = body; held_width[held] = width }
        function report_paragraph_room(    index_, other, measure, word) {
            for (index_ = 1; index_ < held; ++index_) {
                if (held_body[index_] ~ /[.:;!?][])"`\047]*$/) continue
                if (!((held_line[index_] in added) || (held_line[index_ + 1] in added))) continue
                measure = 0
                for (other = 1; other <= held; ++other) if (other != index_ && held_width[other] > measure) measure = held_width[other]
                if (measure > 100) measure = 100
                word = first_word(held_body[index_ + 1])
                if (held_width[index_] + 1 + characters(word) <= measure) printf "line %d: room for `%s` from the next line\n", held_line[index_], word
            }
            held = 0
        }
        function previous_text_ok(text) { return text !~ /:[[:space:]]*(\*\/)?[[:space:]]*$/ && text !~ /https?:\/\// }
        FILENAME == ARGV[1] { added[$1 + 0]; next }
        {
            text = $0
            opens = (text ~ /^[[:space:]]*\/\*/)
            if (opens) { inside = 1; in_code = 0 }
            slashed = !inside && text ~ /^[[:space:]]*\/\//
            if (inside && text ~ /@(code|verbatim)/) in_code = 1
            body = text
            sub(/[[:space:]]*\*\/[[:space:]]*$/, "", body)
            sub(/^[[:space:]]*(\/\*\*?|\*|\/\/\/?)[[:space:]]*/, "", body)
            flowing = (inside || slashed) && !in_code && body != "" && body !~ /^\||https?:\/\// &&
                body !~ /[^[:space:]]   *[^[:space:]]/ && text !~ /@end(code|verbatim)/ && text !~ /^[[:space:]]*\/\/[[:space:]]{4,}/
            block_tag = body ~ /^@[a-z]/ && body !~ /^@(c|p|ref|b|a|e|em)[[:space:]]/
            continues = flowing && !block_tag && body !~ /^(- |[0-9]+\. |[A-Z][A-Za-z]*( [A-Za-z]+)?( [A-Za-z]+)?: )/ && !opens
            if (!(continues && previous_flowing && previous_kind == (slashed ? "slashed" : "block")))
                report_paragraph_room()
            if (flowing) hold_paragraph_line(FNR, body, characters(text))
            previous_flowing = flowing && text !~ /\*\// && previous_text_ok(text)
            previous_kind = slashed ? "slashed" : "block"
            if (inside && text ~ /@end(code|verbatim)/) in_code = 0
            if (inside && text ~ /\*\//) inside = 0
        }
        END { report_paragraph_room() }' "$staged_lines_path" "$staged_blob")
    [ -z "$underfilled" ] || fail "$underfilled" \
        "$file leaves a comment line underfilled - it breaks a sentence while the next word fits under" \
        "            the paragraph's widest line, so pull the word up or re-flow:"
}

check_backward_references() {
    local backrefs
    # Case-sensitive on purpose: lowercase `v2` is a version reference, while uppercase `V2` names
    # real hardware, like the Arm Neoverse cores. Three digits name a SIMD tier like `v128`, never a version.
    backrefs=$(printf '%s\n' "$added" | grep -E '(//|/\*|^\+[[:space:]]*\*)' |
        grep -E '(^|[[:space:]`])v[0-9]{1,2}\b|[Tt]he (previous|old|legacy) (design|implementation|version|draft|approach|convention|code)|\bused to (be|do|work)\b' || true)
    [ -z "$backrefs" ] || fail "$backrefs" \
        "$file cites a past version in a comment - describe the behavior on its own terms;" \
        "            history belongs in commit messages and design docs:"
}

check_banners() { # check_banners <path> < added-lines
    case "$1" in
    *.c | *.h | *.cc | *.cpp | *.cxx | *.hpp | *.hxx | *.cu | *.cuh | *.hip | *.metal | *.pml | *.py | *.pyi | *.pyx | \
        *.rs | *.go | *.zig | *.mojo | *.js | *.mjs | *.cjs | *.ts | *.mts | *.tsx | *.swift | *.java | *.kt | *.cs | \
        *.toml | *.yml | *.yaml | *.cmake | *CMakeLists.txt | *.sh) ;;
    *) return 0 ;;
    esac
    local rulers
    rulers=$(awk -v path="$1" -v quote="'" '
        BEGIN {
            stroke = "(─|━|┄|┅|┈|┉|╌|╍|═)"
            run = "(---+|===+|####+|////+|\\*\\*\\*+|" stroke stroke stroke "+)"
            marker = "^(#|//|/\\*|\\*|--|;)[!/*<]?[ \t]*"
            printed = "(----+|====+|####+|" stroke stroke stroke "+)"
            literal = "[\"" quote "][ \t]*" printed "|" printed "[ \t]*[\"" quote "]"
        }
        /^\+/ {
            text = substr($0, 2); sub(/^[ \t]+/, "", text); sub(/[ \t\r]+$/, "", text)
            if (text == "---" && path ~ /\.ya?ml$/) next
            if (text ~ ("^" run "([ \t].*[ \t]" run ")?$") || text ~ (marker run "[ \t]*(\\*/)?([ \t]|$)") ||
                (text ~ marker && text ~ ("[ \t]" run "[ \t]*(\\*/)?$")) || (text ~ literal && text !~ /\|/))
                print
        }')
    [ -z "$rulers" ] && return 0
    echo "pre-commit: $1 adds a banner ruler; name a section with #pragma region or # region, or a plain sentence:"
    printf '%s\n' "$rulers" | head -5
    return 1
}

check_region_labels() {
    local symbolic
    symbolic=$(printf '%s\n' "$added" |
        grep -E '^\+[[:space:]]*#pragma[[:space:]]+(end)?region[[:space:]]' |
        grep -E '#pragma[[:space:]]+(end)?region[[:space:]]+.*[^A-Za-z0-9 ]' || true)
    [ -z "$symbolic" ] || fail "$symbolic" \
        "$file has a symbol in a #pragma region label - write \`#pragma region Traversal Scratch\`;" \
        "            clang-format reflows a label carrying anything but letters, digits & spaces:"
}

check_region_lengths() {
    local short
    short=$(< "$staged_blob" awk '
        /^[[:space:]]*#pragma[[:space:]]+region/ { opened[++depth] = NR; name[depth] = $0 }
        /^[[:space:]]*#pragma[[:space:]]+endregion/ && depth {
            if (NR - opened[depth] - 1 < 30) printf "line %d: %s\n", opened[depth], name[depth]
            depth--
        }')
    [ -z "$short" ] || fail "$short" \
        "$file has a #pragma region shorter than 30 lines - fold it into its neighbour:"
}

check_namespace_directories() {
    local directory=${file%/*} depth allowed name misplaced="" modality=""
    [ "$directory" = "$file" ] && directory=.
    allowed=" unum ucall ashvardanian numkong stringzilla forkunion smashtable "
    for name in $(printf '%s\n' "$directory" | tr '/' '\n'); do allowed="$allowed$name ${name##*_} "; done
    # Directories beside the file as the index holds them, so a commit may add one along with its first file.
    depth=$(printf '%s\n' "$directory" | awk -F/ '{ print ($0 == "." ? 0 : NF) }')
    for name in $(git ls-files -- "$directory/" | awk -F/ -v depth="$depth" 'NF > depth + 1 { print $(depth + 1) }' |
        sort -u); do
        allowed="$allowed$name "
    done
    case "$file" in
    include/ucall/*/*)
        modality=${file#include/ucall/}
        modality=${modality%%/*}
        ;;
    esac
    while IFS=: read -r line opened; do
        if [ -z "$opened" ]; then
            misplaced="${misplaced}line $line: a nameless namespace
"
            continue
        fi
        if [ -n "$modality" ]; then
            case "$opened" in
            "unum::ucall::$modality") ;;
            unum::ucall | ashvardanian | numkong | stringzilla | forkunion | smashtable)
                [ "$file" = include/ucall/utilities/types.hpp ] ||
                    misplaced="${misplaced}line $line: namespace $opened, not unum::ucall::$modality
" ;;
            *) misplaced="${misplaced}line $line: namespace $opened, not unum::ucall::$modality
" ;;
            esac
            continue
        fi
        for name in $(printf '%s\n' "$opened" | tr ':' '\n'); do
            [ -z "$name" ] && continue
            case "$allowed" in
            *" $name "*) ;;
            *) misplaced="${misplaced}line $line: namespace $name
" ;;
            esac
        done
    done < <(awk 'NR == FNR { touched[$1 + 0]; next }
        FNR in touched && /^[[:space:]]*namespace([[:space:]]+[A-Za-z_][A-Za-z0-9_:]*)?[[:space:]]*\{/ {
            opened = $0; sub(/^[[:space:]]*namespace[[:space:]]*/, "", opened); sub(/[[:space:]]*\{.*/, "", opened)
            print FNR ":" opened }' "$staged_lines_path" "$staged_blob")
    [ -z "$misplaced" ] || fail "${misplaced%$'\n'}" \
        "$file opens a namespace no directory backs - use the directory's namespace, and \`static\` for file-local helpers:"
}

check_rust_modules() {
    local inline
    inline=$(awk '
        /^[[:space:]]*#\[cfg\(test\)\]/ { testing = NR; next }
        /^[[:space:]]*#\[path[[:space:]]*=/ { printf "line %d: #[path] remap\n", NR }
        /^[[:space:]]*(pub(\([a-z]+\))?[[:space:]]+)?mod[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\{/ {
            name = $0; sub(/.*mod[[:space:]]+/, "", name); sub(/[[:space:]]*\{.*/, "", name)
            if (!(name == "tests" && testing == NR - 1)) printf "line %d: inline mod %s\n", NR, name
        }' "$staged_blob")
    [ -z "$inline" ] || fail "$inline" \
        "$file declares a module no file backs - move its items to the file root or into their own file:"
}

check_verb_field_order() {
    local misordered
    misordered=$(< "$staged_blob" awk '
        { sub(/\/\*.*\*\//, "") }
        /\/\*/ { commenting = 1 }
        commenting { if (/\*\//) commenting = 0; next }
        /^typedef struct ucall_[a-z0-9_]+_t \{/ { opened = NR; count = 0; next }
        opened && /^\} ucall_[a-z0-9_]+_t;/ {
            name = $2; sub(/;$/, "", name); arena = 0
            for (field = 1; field <= count; ++field) if (names[field] == "arena" && types[field] == "ucall_arena_t") arena = field
            if (arena) {
                block = arena
                while (block > 1 && output[block - 1]) block--
                for (field = 1; field <= count; ++field) {
                    if (output[field] && field < block)
                        printf "line %d: %s.%s lands apart from the outputs before arena\n", opened, name, names[field]
                    if (field > arena && (output[field] || names[field] == "scalar"))
                        printf "line %d: %s.%s follows arena\n", opened, name, names[field]
                    if (field < arena && names[field] ~ /^outputs_/)
                        printf "line %d: %s.%s precedes arena\n", opened, name, names[field]
                }
            }
            opened = 0; next
        }
        opened && /;[[:space:]]*$/ {
            line = $0; sub(/;[[:space:]]*$/, "", line); sub(/^[[:space:]]+/, "", line)
            field_name = line; sub(/.*[[:space:]*]/, "", field_name)
            field_type = line; sub(/[A-Za-z0-9_]+$/, "", field_type); sub(/[[:space:]*]+$/, "", field_type)
            pointer = line ~ /\*[[:space:]]*[A-Za-z0-9_]+$/
            ++count; names[count] = field_name; types[count] = field_type
            output[count] = pointer && (field_type ~ /_view_t$/ || field_type == "size_t" ||
                                        line ~ /\*\*[[:space:]]*[A-Za-z0-9_]+$/)
        }')
    [ -z "$misordered" ] || fail "$misordered" \
        "$file orders a verb's fields out of reads, writes, arena, knobs and observers:"
}

check_substring_assertions() {
    local fragments
    fragments=$(printf '%s\n' "$added" | grep -nE \
        'pytest\.raises\([^)]*match=|["'"'"'] in (repr|str)\(|(repr|str)\([^)]*\)\.(startswith|endswith)\(|\.to_string\(\)\.(contains|starts_with|ends_with)\(|\.message\.(contains|starts_with|ends_with)\(' || true)
    [ -z "$fragments" ] || fail "$fragments" \
        "$file asserts on a fragment of a repr or a message - compare the whole value, its fields, or the exception:"
}

check_sibling_justification() {
    local borrowed
    borrowed=$(printf '%s\n' "$added" | grep -inE \
        '(the (way|split|shape|idiom|dialect|convention|form|style|precedent))[^.]{0,40}(numkong|stringzilla|forkunion|sibling)|(numkong|stringzilla|forkunion|sibling)[^.]{0,40}(idiom|dialect|house style|does it|spells it|takes|would)|(matching|mirror(s|ing)?|mimic(s|king)?|copie[sd]|borrow(s|ed)?|same as) (how )?(numkong|stringzilla|forkunion|the sibling)' || true)
    [ -z "$borrowed" ] || fail "$borrowed" \
        "$file justifies a design by a sibling project - say what this code does and why," \
        "            not which repository it was copied from:"
}

check_tables_aligned_not_piped() {
    local piped
    piped=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*(\*|//[/!]?|#)[[:space:]]+\|.*\|[[:space:]]*$' || true)
    [ -z "$piped" ] || fail "$piped" \
        "$file draws a pipe table in a comment; pipe tables belong only in Markdown, so align plain" \
        "            columns with spaces, indented 4 past the prose, as in \`*      Instruction   Notes\`:"
}

check_continuation_hanging_indent() {
    local ragged
    ragged=$(awk '
        FILENAME == ARGV[1] { added[$1 + 0]; next }
        {
            text = $0
            if (text ~ /^[[:space:]]*\/\*\*/) { inside = 1; anchor = 0; in_code = 0 }
            if (!inside) next
            if (text ~ /@(code|verbatim)/) { in_code = 1; anchor = 0 }
            if (text ~ /@end(code|verbatim)/) { in_code = 0; next }
            if (text ~ /\*\//) { inside = 0; anchor = 0 }
            if (in_code) next
            if (text ~ /^[[:space:]]*(\/\*\*|\*)[[:space:]]*@(brief|param|tparam|return|returns|retval|note|warning|sa|see|throws|pre|post)([^a-z]|$)/) {
                anchor = index(text, "@") + 4; next
            }
            if (text ~ /^[[:space:]]*\*[[:space:]]+(-|[0-9]+\.) /) {
                match(text, /^[[:space:]]*\*[[:space:]]+(-|[0-9]+\.)[[:space:]]+/); anchor = RLENGTH + 1; next
            }
            block_tag = text ~ /^[[:space:]]*\*[[:space:]]*@[a-z]/ && text !~ /^[[:space:]]*\*[[:space:]]*@(c|p|ref|b|a|e|em)[[:space:]]/
            if (text ~ /^[[:space:]]*\*[[:space:]]*$/ || block_tag || text ~ /^[[:space:]]*\*\//) { anchor = 0; next }
            if (anchor && (FNR in added)) {
                match(text, /^[[:space:]]*\*[[:space:]]*/)
                if (RLENGTH + 1 != anchor) printf "line %d: continuation starts at column %d, expected %d\n", FNR, RLENGTH + 1, anchor
            }
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$ragged" ] || fail "$ragged" \
        "$file misaligns a continuation line - a tag continuation hangs 4 columns past its @, a bullet or" \
        "            numbered-item continuation aligns under the item text:"
}

check_param_directions() {
    local bare
    bare=$(printf '%s\n' "$added" | grep -E '@param' | grep -vE '@param\[(in|out|inout)\]' || true)
    [ -z "$bare" ] || fail "$bare" \
        "$file has a @param without an [in]/[out]/[inout] direction - never a bare @param" \
        "            nor the comma form @param[in,out] (write @param[inout]):"
}

check_markdown_doxygen() {
    local emphasis
    emphasis=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*(\*|//)' |
        grep -oE '\*\*[^*]+\*\*|__[^_]+__' |
        grep -vE '^__(restrict|inline|volatile|asm|attribute|builtin[A-Za-z0-9_]*|STDC)__$' |
        grep -vE '^__[a-z][a-z0-9_]*__$' || true)
    [ -z "$emphasis" ] || fail "$emphasis" \
        "$file uses Markdown emphasis in a Doxygen comment (it prints literally) - use @b" \
        "            for a 1-2 token emphasis, plain prose otherwise:"
}

check_doxygen_glued() {
    local glued
    glued=$(printf '%s\n' "$added" | grep -E '^\+[[:space:]]*(\*|//)' |
        grep -E '[^[:space:]]@(brief|section|subsection|param|tparam|returns?|ref|see|note|file|date|author|c|p|b)\b' || true)
    [ -z "$glued" ] || fail "$glued" \
        "$file glues a Doxygen command to the previous character - write \`as @c foo does\`," \
        "            never \`(@c foo)\`; a highlighter only sees a command that follows whitespace:"
}

check_doxygen_in_line_comments() {
    local tagged
    tagged=$(printf '%s\n' "$added" | grep -E '(^\+|[^:])//[^/!]' |
        grep -E '//[^/!].*[[:space:]]@(brief|param|tparam|returns?|ref|see|note|c|p|b)\b' || true)
    [ -z "$tagged" ] || fail "$tagged" \
        "$file uses a Doxygen command in a // comment, which Doxygen never parses - quote code in backticks:"
}

check_doxygen_trailers() {
    local trailers
    trailers=$(printf '%s\n' "$added" | grep -nE '//!' || true)
    [ -z "$trailers" ] || fail "$trailers" \
        "$file documents with a //! trailer - write /** ... */ above a member, or // after a statement:"
}

check_section_spacing() {
    grep -q '@section' "$staged_blob" || return 0
    local cramped
    cramped=$(awk '
        NR == FNR { added[$1 + 0]; next }
        { lines[FNR] = $0; last = FNR }
        END {
            for (i = 1; i <= last; ++i)
                if (lines[i] ~ /@section/ && (i in added)) {
                    if (lines[i - 1] !~ /^[[:space:]]*\*[[:space:]]*$/) printf "line %d: no empty comment line above the @section\n", i
                    if (lines[i + 1] !~ /^[[:space:]]*\*[[:space:]]*$/) printf "line %d: no empty comment line below the @section\n", i
                }
        }' "$staged_lines_path" "$staged_blob")
    [ -z "$cramped" ] || fail "$cramped" \
        "$file crams an @section against its neighbors - keep one empty comment line" \
