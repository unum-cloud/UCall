top_level_namespaces() { # top_level_namespaces < source
    awk '
        continued { continued = ($0 ~ /\\$/); next }
        {
            code = ""
            for (i = 1; i <= length($0); ++i) {
                c = substr($0, i, 1)
                pair = substr($0, i, 2)
                if (state == "block") { if (pair == "*/") { state = ""; ++i } continue }
                if (state != "") {
                    if (c == "\\") ++i
                    else if (c == state) state = ""
                    continue
                }
                if (pair == "//") break
                if (pair == "/*") { state = "block"; ++i; continue }
                if (c == "\"" || c == "'\''") { state = c; continue }
                code = code c
            }
            if (state != "block") state = ""
            if (code ~ /^[[:space:]]*#/) { continued = ($0 ~ /\\$/); next }
            if (depth == 0 && match(code, /(^|[^A-Za-z0-9_])namespace([[:space:]]+[A-Za-z_][A-Za-z0-9_:]*)?[[:space:]]*\{/)) {
                name = substr(code, RSTART, RLENGTH)
                sub(/^.*namespace[[:space:]]*/, "", name)
                sub(/[[:space:]]*\{$/, "", name)
                print NR ":" (name == "" ? "<anonymous>" : name)
            }
            depth += gsub(/\{/, "{", code) - gsub(/\}/, "}", code)
        }'
}

