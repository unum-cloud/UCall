        check_sibling_justification
        check_python_version_probe
        check_python_array_annotations
        check_python_constant_comments
        check_substring_assertions
        if command -v ruff > /dev/null 2>&1; then
            if ! ruff format --check --stdin-filename "$file" < "$staged_blob" > /dev/null 2>&1; then
                fail "$file" "Run ruff format on the staged Python source."
            fi
            if ! ruff check --stdin-filename "$file" - < "$staged_blob" > /dev/null 2>&1; then
                fail "$file" "Run ruff check on the staged Python source."
            fi
        fi
        ;;
    .github/workflows/*.yml | .github/workflows/*.yaml) check_workflow_names ;;
    CMakeLists.txt | */CMakeLists.txt | *.cmake)
        check_cmake_string_surgery
        check_cmake_conventions "$file" "$staged_blob" "$staged_lines_path" || rejection_count=$((rejection_count + 1))
        if command -v cmake-format > /dev/null 2>&1 && ! cmake-format --config-files "$PWD/.cmake-format.py" --check "$staged_blob" > /dev/null 2>&1; then
            fail "$file" "Run cmake-format with the repository profile."
        fi
        ;;
    *.rs)
        check_ids_capitalized
        check_rust_use_groups ucall "$file" < "$staged_blob" || rejection_count=$((rejection_count + 1))
        check_rust_modules
        check_substring_assertions
        check_path_hops
        ;;
    esac
    case "$file" in include/ucall/*.hpp | src/*.cpp | src/*.hpp) check_allocating_new ;; esac
    case "$file" in include/* | src/* | c/* | python/*) check_library_filesystem ;; esac
    case "$file" in
    *.c | *.h | *.hpp | *.cpp | *.cc | *.cxx)
        if command -v clang-format > /dev/null 2>&1 &&
            ! clang-format --dry-run -Werror --assume-filename="$file" < "$staged_blob" > /dev/null 2>&1; then
            fail "$file" "Run clang-format on the staged C or C++ source."
        fi
        ;;
    esac
    case "$file" in
    *.c | *.h | *.hpp | *.cpp | *.cc | *.cxx | *.py | *.pyi | *.rs | *.go | *.sh | *.cmake | CMakeLists.txt)
        check_tables_aligned_not_piped
        ;;
    esac
    check_banners "$file" <<< "$added" || rejection_count=$((rejection_count + 1))
}

run_tree_checks() {
    if command -v cargo > /dev/null 2>&1 && [ -f Cargo.toml ] &&
        git diff --cached --name-only "$lint_base" -- '*.rs' | read -r _; then
        if ! cargo +nightly fmt --check > /dev/null 2>&1; then
            fail "Cargo.toml" "Run cargo +nightly fmt."
        fi
    fi
    while read -r sibling pinned; do
        recorded=$(git ls-files --stage -- "$sibling" | awk '$1 == "160000" { print $2 }')
        if [ -z "$pinned" ] || [ "$recorded" != "$pinned" ]; then
            fail "$sibling" "The CMake pin and the staged submodule must name the same commit."
        fi
    done < <(git show :CMakeLists.txt | awk '
        /^[[:space:]]*ucall_sibling\(/ { in_call = 1; name = ""; pin = "" }
        in_call {
            for (i = 1; i <= NF; ++i) {
                token = $i; gsub(/[()]/, "", token)
                if (token == "ucall_sibling" || token == "") continue
                if (name == "") name = token
                else if (token ~ /^[0-9a-f]+$/ && length(token) == 40) pin = token
            }
            if (/\)/) { in_call = 0; print name, pin }
        }
    ')
    for example in $(git ls-files -- 'examples/*/*' | cut -d/ -f2 | sort -u); do
        for required in README.md server.cpp; do
            git ls-files --error-unmatch -- "examples/$example/$required" > /dev/null 2>&1 ||
                fail "examples/$example/$required" "Every example folder holds its own README.md and server.cpp."
        done
    done
    nested=$(git ls-files -- 'bench/*/*')
    [ -z "$nested" ] || fail "$nested" "bench/ stays flat: name each file by its backend and role instead of nesting it."
}

lint_base=${UCALL_LINT_BASE:-HEAD}
git rev-parse --verify HEAD > /dev/null 2>&1 || exit 0

results_directory=$(mktemp -d)
trap 'rm -rf "$results_directory"' EXIT

# Splits a zero-context diff into files numbered in diff order from `ordinal + 1`: its hunks, its added lines,
# their numbers, and the `--lines` ranges clang-format takes, where a hunk that only deletes covers one line.
split_diff_by_path='
    /^diff --git / {
        close(diff); close(added); close(lines); close(ranges); ++ordinal; hunk = 0
        diff = directory ordinal ".diff"; added = directory ordinal ".added"
        lines = directory ordinal ".lines"; ranges = directory ordinal ".ranges"
        next
    }
    /^@@/ {
        hunk = 1
        split($3, range, ",")
        start = substr(range[1], 2) + 0
        count = (range[2] == "") ? 1 : range[2] + 0
        for (line = start; line < start + count; ++line) print line > lines
        printf "--lines=%d:%d\n", start, start + (count ? count : 1) - 1 > ranges
    }
    hunk { print > diff }
    hunk && /^\+/ { print > added }'

# Lists the staged paths, writes their blobs under `index/` and splits their diff, one git process each, so
# no check asks git again; `git diff` lists paths in the same order whether it prints names or hunks.
read_staged_paths() {
    staged_paths=()
    while IFS= read -r -d '' staged_path; do staged_paths+=("$staged_path"); done \
        < <(git diff --cached --name-only -z --diff-filter=ACMR "$lint_base")
    [ ${#staged_paths[@]} -eq 0 ] || printf '%s\0' "${staged_paths[@]}" |
        git checkout-index --prefix="$results_directory/index/" -z --stdin
    git diff --cached --unified=0 --diff-filter=ACMR "$lint_base" | awk -v directory="$results_directory/" "$split_diff_by_path"
}

# Deals the paths round-robin to one worker per core, each running `judge_path` into a numbered report, then
# prints the reports in path order, so the output reads exactly as a serial run's would.
judge_paths_in_parallel() { # judge_paths_in_parallel <path>...
    local worker worker_count ordinal
    worker_count=$(getconf _NPROCESSORS_ONLN 2> /dev/null || echo 4)
    [ "$worker_count" -le $# ] || worker_count=$#
    for ((worker = 0; worker < worker_count; ++worker)); do
        (
            ordinal=0
            for staged_path in "$@"; do
                ordinal=$((ordinal + 1))
                [ $(((ordinal - 1) % worker_count)) -eq "$worker" ] || continue
                # A selftest carries one violation per rule by design.
                [ "$staged_path" = .githooks/selftest ] || judge_path > "$results_directory/$ordinal"
            done
            echo "$rejection_count" > "$results_directory/count-$worker"
        ) &
    done
    wait
    for ((ordinal = 1; ordinal <= $#; ++ordinal)); do
        [ ! -f "$results_directory/$ordinal" ] || cat "$results_directory/$ordinal"
    done
    for ((worker = 0; worker < worker_count; ++worker)); do
        if [ -f "$results_directory/count-$worker" ]; then
            rejection_count=$((rejection_count + $(cat "$results_directory/count-$worker")))
        else
            fail "worker $worker" "A source check failed to finish."
        fi
    done
}

# Runs the staged-mode judging: the checks over the whole commit start first and overlap the per-path
# workers, and still report after them.
judge_staged_paths() {
    read_staged_paths
    (
        run_tree_checks > "$results_directory/tree"
        echo "$rejection_count" > "$results_directory/count-tree"
    ) &
    judge_paths_in_parallel ${staged_paths[@]+"${staged_paths[@]}"}
    cat "$results_directory/tree"
    if [ -f "$results_directory/count-tree" ]; then
        rejection_count=$((rejection_count + $(cat "$results_directory/count-tree")))
    else
        fail "tree checks" "A source check failed to finish."
    fi
}


judge_staged_paths

[ "$rejection_count" -eq 0 ]
