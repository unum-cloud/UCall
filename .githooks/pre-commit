check_template_type_suffixes() {
    local suffixed aliases variables
    suffixed=$(awk '
        NR == FNR { touched[$1] = 1; next }
        /^[[:space:]]*template[[:space:]]*</ { pending = 1; declaration = FNR }
        pending && /(^|>)[[:space:]]*(struct|class)[[:space:]]+[A-Za-z0-9_]+_t([^A-Za-z0-9_]|$)/ {
            if (touched[FNR] || touched[declaration]) print FNR ": " $0
        }
        /[;{]/ { pending = 0 }' "$results_directory/$ordinal.lines" "$staged_blob")
    [ -z "$suffixed" ] || fail "$suffixed" \
        "$file names a class template with the _t suffix - name the template bare, as in" \
        "            \`template <typename value_type_> struct humanized\`, and keep _t for instantiated types:"
    aliases=$(awk '
        NR == FNR { touched[$1] = 1; next }
        /^[[:space:]]*template[[:space:]]*</ { pending = 1; declaration = FNR }
        pending && /(^|>)[[:space:]]*using[[:space:]]+[A-Za-z0-9_]+_[tk][[:space:]]*=/ {
            if (touched[FNR] || touched[declaration]) print FNR ": " $0
        }
        /[;{]/ { pending = 0 }' "$results_directory/$ordinal.lines" "$staged_blob")
    [ -z "$aliases" ] || fail "$aliases" \
        "$file names an alias template with _t or _k - only instantiated aliases carry those suffixes:"
    variables=$(printf '%s\n' "$added" | awk '
        # A `static` member of a class template is not a variable template, though an unchanged `struct` line between
        # them leaves only the `template` line and the member among the added lines.
        function suffixed(line) {
            return line ~ /constexpr[[:space:]][^=({]*[[:space:]][A-Za-z0-9_]*_[kt][[:space:]]*[={]/ && line !~ /[[:space:]]static[[:space:]]/
        }
        /^\+[[:space:]]*template[[:space:]]*</ { if (suffixed($0)) print; else pending = 1; next }
        pending && /^\+[[:space:]]*requires/ { next }
        pending && suffixed($0) { print }
        { pending = 0 }' || true)
    [ -z "$variables" ] || fail "$variables" \
        "$file names a variable template with the _k or _t suffix - name the template bare, as in" \
        "            \`template <typename index_type_> constexpr bool device_resident\`:"
}

