{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(GDB) Attach Python",
      "type": "cppdbg",
      "request": "attach",
      "program": "/usr/bin/python3",
      "processId": "${command:pickProcess}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    },
    {
      "name": "Python C++ Debug Current File",
      "type": "pythoncpp",
      "request": "launch",
      "pythonConfig": "default",
      "cppAttachName": "(GDB) Attach Python",
    },
    {
      "name": "GoLang: Current File",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${file}"
    },
    {
      "name": "Python: Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: PyTest Current File",
      "type": "python",
      "request": "launch",
      "program": "pytest ${file}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": true
    },
    {
      "name": "C++: Echo Example",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build_debug_siblings/ucall_example_echo",
      "cwd": "${workspaceFolder}",
      "environment": [],
      "showDisplayString": true,
      "stopAtEntry": false,
      "externalConsole": false,
      "preLaunchTask": "Build Debug",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    },
    {
      "name": "C++: Network Suite",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build_debug_siblings/ucall_test_network",
      "cwd": "${workspaceFolder}",
      "environment": [],
      "showDisplayString": true,
      "stopAtEntry": false,
      "externalConsole": false,
      "preLaunchTask": "Build Debug",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    },
  ]
}
