{
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true,
    "editor.rulers": [120]
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true,
    "editor.rulers": [120]
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
    "editor.formatOnSave": false,
    "editor.rulers": [120]
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.rulers": [120]
  },
  "clangd.arguments": [
    "--background-index",
    "--header-insertion=never"
  ],
  "cSpell.words": [
    "Armv",
    "ashvardanian",
    "asynchrony",
    "constexpr",
    "Diffie",
    "endregion",
    "fastapi",
    "HPACK",
    "IORING",
    "mbed",
    "ndarray",
    "numpy",
    "OLAP",
    "posix",
    "QUIC",
    "retval",
    "SIMD",
    "stringzilla",
    "TASKRUN",
    "ucall",
    "uform",
    "uring",
    "usearch",
    "uvicorn",
    "Vardanian",
    "vectorize"
  ],
  "files.associations": {
    "*.inc": "cpp",
    "*.tcc": "cpp"
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/build*/**": true,
    "**/dist*/**": true,
    "**/node_modules/**": true,
    "**/target/**": true,
    "data/**": true,
    "datasets/**": true,
    "forkunion/**": true,
    "smashtable/**": true,
    "stringzilla/**": true
  },
  "python.analysis.exclude": [
    "**/.venv/**",
    "**/__pycache__/**",
    "**/build*/**",
    "**/dist*/**",
    "**/node_modules/**",
    "**/target/**",
    "data/**",
    "datasets/**",
    "forkunion/**",
    "smashtable/**",
    "stringzilla/**"
  ],
  "search.exclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/build*/**": true,
    "**/dist*/**": true,
    "**/node_modules/**": true,
    "**/target/**": true,
    "data/**": true,
    "datasets/**": true,
    "forkunion/**": true,
    "smashtable/**": true,
    "stringzilla/**": true
  }
}
