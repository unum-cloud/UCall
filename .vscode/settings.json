{
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true,
    "editor.rulers": [120]
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true,
    "editor.rulers": [120]
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
    "editor.formatOnSave": false,
    "editor.rulers": [120]
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.rulers": [120]
  },
  "clangd.arguments": [
    "--background-index",
    "--header-insertion=never"
  ],
  "cSpell.words": [
    "Armv",
    "ashvardanian",
    "asynchrony",
    "batchable",
    "constexpr",
    "cxxopts",
    "Diffie",
    "endregion",
    "fastapi",
    "Googlebot",
    "HPACK",
    "IORING",
    "iovecs",
